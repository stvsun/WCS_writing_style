% wsun_macros.sty
% Standard Continuum Mechanics, Poromechanics, Lie Group, and SciML Macros
% Prof. WaiChing Sun Research Group (Columbia University)

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{wsun_macros}[2026/10/30 WaiChing Sun Group Standard Macros]

\RequirePackage{amsmath,amssymb,amsfonts,amsthm,bm,mathtools}

% --- Theorem, Remark, Proposition, and Definition Environments ---
\newtheorem{theorem}{Theorem}[section]
\newtheorem{proposition}[theorem]{Proposition}
\newtheorem{lemma}[theorem]{Lemma}
\newtheorem{corollary}[theorem]{Corollary}
\theoremstyle{definition}
\newtheorem{definition}[theorem]{Definition}
\newtheorem{assumption}[theorem]{Assumption}
\theoremstyle{remark}
\newtheorem{remark}{Remark}[section]

% --- Tensor and Vector Formatting ---
\newcommand{\ten}[1]{\boldsymbol{#1}}
\newcommand{\tten}[1]{\mathbb{#1}}
\newcommand{\mat}[1]{\mathbf{#1}}
\newcommand{\tns}[1]{\boldsymbol{#1}}

% --- Differential and Continuum Operators ---
\DeclareMathOperator{\grad}{grad}
\DeclareMathOperator{\Grad}{Grad}
\DeclareMathOperator{\divv}{div}
\DeclareMathOperator{\Divv}{Div}
\DeclareMathOperator{\curl}{curl}
\DeclareMathOperator{\Curl}{Curl}
\DeclareMathOperator{\sym}{sym}
\DeclareMathOperator{\skw}{skw}
\DeclareMathOperator{\tr}{tr}
\DeclareMathOperator{\dev}{dev}
\DeclareMathOperator{\detm}{det}
\DeclareMathOperator{\diag}{diag}
\DeclareMathOperator{\argmin}{arg\,min}
\DeclareMathOperator{\argmax}{arg\,max}
\DeclareMathOperator{\sgn}{sgn}

